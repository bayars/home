    { "id": "vpc", "label": "VPC 10.0.0.0/16", "kind": "aws.vpc", "parent": "region" },
    { "id": "az1", "label": "Availability Zone a", "kind": "aws.az", "parent": "vpc" },
    { "id": "az2", "label": "Availability Zone b", "kind": "aws.az", "parent": "vpc" },
    { "id": "pub1", "label": "Public subnet", "kind": "aws.subnet_public", "parent": "az1" },
    { "id": "priv1", "label": "Private subnet", "kind": "aws.subnet_private", "parent": "az1" },
    { "id": "pub2", "label": "Public subnet", "kind": "aws.subnet_public", "parent": "az2" },
    { "id": "priv2", "label": "Private subnet", "kind": "aws.subnet_private", "parent": "az2" }
  ],
  "nodes": [
