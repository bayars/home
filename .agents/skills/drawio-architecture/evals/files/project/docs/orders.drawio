<diagram id="page-1" name="Order processing: services and data flow">
<mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="none" background="#ffffff">
<root>
<object label="" description="How an order moves through the order processing services; no infrastructure is shown. A customer uses the web app, which calls the Order service through the API gateway. The Order service checks stock with the Inventory service (backed by a Redis stock cache), charges through the Billing service and its payment provider, and stores the order in the Orders database. It then publishes an OrderPlaced event to a Kafka topic; the Notification worker consumes it and sends e-mail through an outside e-mail API. Solid lines are synchronous calls, dashed lines are asynchronous events." generator="drawio-architecture-skill" spec="{&quot;title&quot;:&quot;Order processing: services and data flow&quot;,&quot;direction&quot;:&quot;right&quot;,&quot;groups&quot;:[{&quot;id&quot;:&quot;edge&quot;,&quot;label&quot;:&quot;Edge&quot;,&quot;kind&quot;:&quot;group&quot;,&quot;color&quot;:&quot;green&quot;},{&quot;id&quot;:&quot;core&quot;,&quot;label&quot;:&quot;Core services&quot;,&quot;kind&quot;:&quot;group&quot;,&quot;color&quot;:&quot;blue&quot;},{&quot;id&quot;:&quot;data&quot;,&quot;label&quot;:&quot;Data&quot;,&quot;kind&quot;:&quot;group&quot;,&quot;color&quot;:&quot;yellow&quot;},{&quot;id&quot;:&quot;ext&quot;,&quot;label&quot;:&quot;Third parties&quot;,&quot;kind&quot;:&quot;boundary&quot;}],&quot;nodes&quot;:[{&quot;id&quot;:&quot;user&quot;,&quot;label&quot;:&quot;Customer&quot;,&quot;kind&quot;:&quot;actor&quot;},{&quot;id&quot;:&quot;web&quot;,&quot;label&quot;:&quot;Web app&quot;,&quot;kind&quot;:&quot;client&quot;,&quot;tech&quot;:&quot;Next.js&quot;,&quot;parent&quot;:&quot;edge&quot;},{&quot;id&quot;:&quot;gw&quot;,&quot;label&quot;:&quot;API gateway&quot;,&quot;kind&quot;:&quot;service&quot;,&quot;tech&quot;:&quot;Kong&quot;,&quot;parent&quot;:&quot;edge&quot;},{&quot;id&quot;:&quot;orders&quot;,&quot;label&quot;:&quot;Order service&quot;,&quot;kind&quot;:&quot;service&quot;,&quot;tech&quot;:&quot;Go&quot;,&quot;desc&quot;:&quot;Owns the order lifecycle.&quot;,&quot;parent&quot;:&quot;core&quot;},{&quot;id&quot;:&quot;inventory&quot;,&quot;label&quot;:&quot;Inventory service&quot;,&quot;kind&quot;:&quot;service&quot;,&quot;tech&quot;:&quot;Java&quot;,&quot;parent&quot;:&quot;core&quot;},{&quot;id&quot;:&quot;billing&quot;,&quot;label&quot;:&quot;Billing service&quot;,&quot;kind&quot;:&quot;service&quot;,&quot;tech&quot;:&quot;Python&quot;,&quot;parent&quot;:&quot;core&quot;},{&quot;id&quot;:&quot;notify&quot;,&quot;label&quot;:&quot;Notification worker&quot;,&quot;kind&quot;:&quot;service&quot;,&quot;tech&quot;:&quot;Node.js&quot;,&quot;parent&quot;:&quot;core&quot;},{&quot;id&quot;:&quot;events&quot;,&quot;label&quot;:&quot;order-events&quot;,&quot;kind&quot;:&quot;queue&quot;,&quot;tech&quot;:&quot;Kafka topic&quot;,&quot;parent&quot;:&quot;data&quot;},{&quot;id&quot;:&quot;pg&quot;,&quot;label&quot;:&quot;Orders DB&quot;,&quot;kind&quot;:&quot;database&quot;,&quot;tech&quot;:&quot;PostgreSQL&quot;,&quot;parent&quot;:&quot;data&quot;},{&quot;id&quot;:&quot;cache&quot;,&quot;label&quot;:&quot;Stock cache&quot;,&quot;kind&quot;:&quot;database&quot;,&quot;tech&quot;:&quot;Redis&quot;,&quot;parent&quot;:&quot;data&quot;,&quot;color&quot;:&quot;red&quot;},{&quot;id&quot;:&quot;psp&quot;,&quot;label&quot;:&quot;Payment provider&quot;,&quot;kind&quot;:&quot;external&quot;,&quot;parent&quot;:&quot;ext&quot;},{&quot;id&quot;:&quot;mailer&quot;,&quot;label&quot;:&quot;E-mail API&quot;,&quot;kind&quot;:&quot;external&quot;,&quot;parent&quot;:&quot;ext&quot;},{&quot;id&quot;:&quot;legend&quot;,&quot;label&quot;:&quot;Solid: synchronous call\nDashed: asynchronous event&quot;,&quot;kind&quot;:&quot;note&quot;}],&quot;edges&quot;:[{&quot;from&quot;:&quot;user&quot;,&quot;to&quot;:&quot;web&quot;},{&quot;from&quot;:&quot;web&quot;,&quot;to&quot;:&quot;gw&quot;,&quot;label&quot;:&quot;HTTPS&quot;},{&quot;from&quot;:&quot;gw&quot;,&quot;to&quot;:&quot;orders&quot;,&quot;label&quot;:&quot;REST&quot;},{&quot;from&quot;:&quot;orders&quot;,&quot;to&quot;:&quot;inventory&quot;,&quot;label&quot;:&quot;gRPC&quot;},{&quot;from&quot;:&quot;orders&quot;,&quot;to&quot;:&quot;billing&quot;,&quot;label&quot;:&quot;gRPC&quot;},{&quot;from&quot;:&quot;orders&quot;,&quot;to&quot;:&quot;pg&quot;},{&quot;from&quot;:&quot;inventory&quot;,&quot;to&quot;:&quot;cache&quot;},{&quot;from&quot;:&quot;billing&quot;,&quot;to&quot;:&quot;psp&quot;,&quot;label&quot;:&quot;charge&quot;},{&quot;from&quot;:&quot;orders&quot;,&quot;to&quot;:&quot;events&quot;,&quot;label&quot;:&quot;OrderPlaced&quot;,&quot;dashed&quot;:true},{&quot;from&quot;:&quot;events&quot;,&quot;to&quot;:&quot;notify&quot;,&quot;label&quot;:&quot;consume&quot;,&quot;dashed&quot;:true},{&quot;from&quot;:&quot;notify&quot;,&quot;to&quot;:&quot;mailer&quot;,&quot;label&quot;:&quot;send&quot;}]}" fingerprint="988081e2c66d3011" id="0"><mxCell/></object>
