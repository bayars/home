<diagram id="page-1" name="Head office network">
<mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="none" background="#ffffff">
<root>
<object label="" description="Physical and logical network of the head office, top to bottom from the Internet. Traffic enters through the edge router and a firewall pair. The firewall publishes a reverse proxy (443) and a mail gateway (25) in the DMZ and passes internal traffic to the core switch. The internal LAN has two VLANs: a server VLAN with application servers, a database cluster and backup storage that receives nightly copies, and an office VLAN where an access switch serves workstations and the Wi-Fi access points used by laptops." generator="drawio-architecture-skill" spec="{&quot;title&quot;:&quot;Head office network&quot;,&quot;direction&quot;:&quot;down&quot;,&quot;groups&quot;:[{&quot;id&quot;:&quot;dmz&quot;,&quot;label&quot;:&quot;DMZ 172.16.0.0/24&quot;,&quot;kind&quot;:&quot;boundary&quot;,&quot;color&quot;:&quot;orange&quot;},{&quot;id&quot;:&quot;lan&quot;,&quot;label&quot;:&quot;Internal LAN 10.0.0.0/16&quot;,&quot;kind&quot;:&quot;group&quot;},{&quot;id&quot;:&quot;srv&quot;,&quot;label&quot;:&quot;Server VLAN 20&quot;,&quot;kind&quot;:&quot;boundary&quot;,&quot;parent&quot;:&quot;lan&quot;},{&quot;id&quot;:&quot;office&quot;,&quot;label&quot;:&quot;Office VLAN 10&quot;,&quot;kind&quot;:&quot;boundary&quot;,&quot;parent&quot;:&quot;lan&quot;}],&quot;nodes&quot;:[{&quot;id&quot;:&quot;internet&quot;,&quot;label&quot;:&quot;Internet&quot;,&quot;kind&quot;:&quot;cloud&quot;},{&quot;id&quot;:&quot;edge&quot;,&quot;label&quot;:&quot;Edge router&quot;,&quot;icon&quot;:&quot;cisco.router&quot;},{&quot;id&quot;:&quot;fw&quot;,&quot;label&quot;:&quot;Firewall pair&quot;,&quot;icon&quot;:&quot;cisco.firewall&quot;},{&quot;id&quot;:&quot;proxy&quot;,&quot;label&quot;:&quot;Reverse proxy&quot;,&quot;icon&quot;:&quot;net.server&quot;,&quot;parent&quot;:&quot;dmz&quot;},{&quot;id&quot;:&quot;mail&quot;,&quot;label&quot;:&quot;Mail gateway&quot;,&quot;icon&quot;:&quot;net.mail_server&quot;,&quot;parent&quot;:&quot;dmz&quot;},{&quot;id&quot;:&quot;core&quot;,